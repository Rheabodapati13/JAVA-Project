import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

class ScientificCalculator extends JFrame implements ActionListener {
    private final JTextField display;
    private double result = 0;
    private String lastCommand = "=";
    private boolean start = true;
    
    public ScientificCalculator() {
        setTitle("Scientific Calculator");
        setSize(420, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        display = new JTextField("0");
        display.setEditable(false);
        display.setFont(new Font("Times New Roman", Font.BOLD, 24));
        display.setHorizontalAlignment(JTextField.RIGHT);
        add(display, BorderLayout.NORTH);
        
        String[] buttons = {
            "C", "CE", "%", "/", "sin",
            "7", "8", "9", "*", "cos",
            "4", "5", "6", "-", "tan",
            "1", "2", "3", "+", "pow",
            "(", "0", ")", ".", "=",
        };
        
        JPanel panel = new JPanel(new GridLayout(5, 5, 5, 5));
        for (String text : buttons) {
            JButton button = new JButton(text);
            button.setFont(new Font("Times New Roman", Font.PLAIN, 18));
            button.addActionListener(this);
            panel.add(button);
        }
        add(panel, BorderLayout.CENTER);
    }

    @Override
    
    public void actionPerformed(ActionEvent e) {
        String command = e.getActionCommand();
        try {
            switch (command) {
                case "C" -> {
                    display.setText("0"); result = 0; start = true;
                }
                case "CE" -> {
                    display.setText("0"); start = true;
                }
                case "sin" -> {
                    display.setText(String.valueOf(Math.sin(Math.toRadians(
                            Double.parseDouble(display.getText()))))); start = true;
                }
                case "cos" -> {
                    display.setText(String.valueOf(Math.cos(Math.toRadians(
                            Double.parseDouble(display.getText()))))); start = true;
                }
                case "tan" -> {
                    display.setText(String.valueOf(Math.tan(Math.toRadians(
                            Double.parseDouble(display.getText()))))); start = true;
                }
                case "=" -> 
                    calculate(Double.parseDouble(display.getText()));
                case "+", "-", "*", "/", "pow", "%" -> {
                    calculate(Double.parseDouble(display.getText()));
                    lastCommand = command; start = true;
                }
                default -> {
                    if (start) { display.setText(command); start = false; }
                    else { display.setText(display.getText() + command); }
                }
                }
            } catch (NumberFormatException ex) {
                display.setText("Error");
                start = true;
            }
        }
        
        private void calculate(double x) {
            switch (lastCommand) {
                case "+" -> result += x;
                case "-" -> result -= x;
                case "*" -> result *= x;
                case "/" -> result = (x != 0) ? result / x : 0;
                case "pow" -> result = Math.pow(result, x);
                case "%" -> result = result % x;
                case "=" -> result = x;
            }
        display.setText(String.valueOf(result));
        lastCommand = "=";
    }     
    
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new ScientificCalculator().setVisible(true));
    }
}
